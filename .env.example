# Copy to .env.local (gitignored) — or run `pnpm setup:env` to do it with generated secrets.
# apps/api/src/config/env.ts validates all of this through Zod and REFUSES TO BOOT on anything
# missing or malformed. See plan.md Appendix A for the full production variable list.

NODE_ENV=development
PROCESS_TYPE=api                 # api | ws | worker
PORT=4000
APP_URL=http://localhost:5180
API_URL=http://localhost:4000

# Mongo MUST be a replica set, even in dev (transactions depend on it).
MONGO_URI=mongodb://localhost:27017/finpilot?replicaSet=rs0&directConnection=true
MONGO_MAX_POOL=50
# FinPilot's dev redis is mapped to host 6380 (6379 is used by another local project)
REDIS_URL=redis://localhost:6380

# REQUIRED — no default, boot fails without it. 64 hex chars.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# REQUIRED — AES-256-GCM key for TOTP secrets at rest. 64 hex chars.
# Production uses a KMS-held DEK instead (ENCRYPTION_KEK_ARN).
ENCRYPTION_KEY=
ARGON2_MEMORY_KIB=19456

# S3 / MinIO (docker-compose dev defaults)
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=finpilot-documents
S3_ACCESS_KEY=finpilot
S3_SECRET_KEY=finpilot-dev-secret
S3_REGION=ap-south-1

# Mail (Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="FinPilot <no-reply@finpilot.local>"

LOG_LEVEL=debug

# ── Optional integrations (features degrade gracefully when unset) ──────────
# Test credentials work end to end: Razorpay hosts the checkout either way, and
# test mode gives you card numbers that "pay" without money moving.
#
# 1. Dashboard -> Settings -> API Keys -> Generate Test Key
#      RAZORPAY_KEY_ID      starts rzp_test_
#      RAZORPAY_KEY_SECRET
# 2. Dashboard -> Subscriptions -> Plans -> create one plan per tier
#    (monthly; amounts must match PLAN_PRICE_PAISE in packages/shared:
#     starter 99900, professional 299900, enterprise 999900 paise)
#    Paste each plan_... id below.
# 3. Dashboard -> Settings -> Webhooks -> add
#      URL     <public url>/api/v1/webhooks/razorpay
#      Events  subscription.activated, subscription.charged, payment.captured
#      Secret  -> RAZORPAY_WEBHOOK_SECRET
#    Locally the webhook needs a tunnel (ngrok/cloudflared) to reach :4000.
#
# Until KEY_ID and KEY_SECRET are set, the Plans screen says Razorpay is not
# configured rather than failing when someone clicks Subscribe.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID_STARTER=
# RAZORPAY_PLAN_ID_PROFESSIONAL=
# RAZORPAY_PLAN_ID_ENTERPRISE=
# Sentry error capture (plan.md §27) — off unless a DSN is set
# SENTRY_DSN=

# OCR cascade (plan.md §16) — self-hosted, so it needs no keys and costs ₹0.
# A clean PDF is read from its text layer; scans and photos go to Tesseract.
# OCR_LANG=eng                 # Tesseract traineddata language(s), e.g. "eng+hin"
# OCR_MAX_PAGES=5              # pages rasterised per scanned PDF (~1 s each)
# OCR_CACHE_PATH=              # where the language model is cached; defaults
#                              # to node_modules/.cache/tesseract
